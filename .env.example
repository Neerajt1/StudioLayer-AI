# =============================================================================
# StudioLayer AI — Local development environment (Cursor / macOS)
# =============================================================================
#
# This project loads the root `.env` automatically when starting the API server
# via Node's --env-file-if-exists (see artifacts/api-server/package.json "start").
# Replit injects the same variables from Secrets / database provisioning.
#
# Copy this file:  cp .env.example .env
# Then start services:
#
#   pnpm run dev:api    # terminal 1 — loads ../../.env from repo root
#   pnpm run dev:web    # terminal 2
#
# Database migrations (shell must still export env, or use the same source pattern):
#   set -a && source .env && set +a && pnpm --filter @workspace/db run push
# =============================================================================


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Component: @workspace/db, Drizzle ORM, all API routes
# Required:  YES — server throws on startup if unset
# -----------------------------------------------------------------------------
# PostgreSQL connection string for your local instance.
# Example shape only — replace with your host, port, database, user, and password.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studiolayer


# -----------------------------------------------------------------------------
# Razorpay — membership subscriptions (Test Mode only until explicitly switched)
# Component: artifacts/api-server/src/billing/*, routes/payments.ts
# Required:  YES for membership checkout + webhooks
# Notes:     KEY_SECRET and WEBHOOK_SECRET are backend-only — never expose to the frontend.
#            Plan IDs must be configured server-side; clients send only "basic" | "pro".
# Webhook:   Production Dashboard URL must be the canonical API host:
#            https://api.studiolayerai.com/api/payments/razorpay/webhook
#            (not the Railway-generated *.up.railway.app hostname).
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASIC_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional dual-currency Razorpay plans (frozen market prices).
# When unset, checkout continues to use RAZORPAY_BASIC_PLAN_ID / RAZORPAY_PRO_PLAN_ID.
# India (INR, GST-inclusive): ₹3,999 / ₹6,999
# RAZORPAY_BASIC_PLAN_ID_INR=
# RAZORPAY_PRO_PLAN_ID_INR=
# Outside India (USD): $49 / $79 — requires Razorpay International Payments
# RAZORPAY_BASIC_PLAN_ID_USD=
# RAZORPAY_PRO_PLAN_ID_USD=

# -----------------------------------------------------------------------------
# Studio Credit — legacy UTC membership bridge (pre-Razorpay paid members)
# Component: lib/studio-credit-engine + studio-credit-service
# Default:   ON (true) when unset — keeps legacy paid users spendable
# Cutover:   After Razorpay membership allocations are authoritative for all
#            paid customers, set STUDIO_CREDIT_LEGACY_MEMBERSHIP_BRIDGE=false
#            so UTC-month implicit pools cannot reappear beside Razorpay lots.
#            Bridge already returns 0 when an active membership lot covers now.
# -----------------------------------------------------------------------------
# STUDIO_CREDIT_LEGACY_MEMBERSHIP_BRIDGE=false


# -----------------------------------------------------------------------------
# Authentication & sessions
# Component: artifacts/api-server (express-session in app.ts)
# Required:  YES — server throws on startup if unset
# -----------------------------------------------------------------------------
# Long random string used to sign session cookies. Generate your own, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=


# -----------------------------------------------------------------------------
# API server
# Component: artifacts/api-server/src/index.ts, app.ts, lib/logger.ts
# Required:  PORT yes (default provided in package.json dev script: 8080)
#            NODE_ENV and LOG_LEVEL optional
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# OpenAI — Intelligence Engine (vision + outfit decisions)
# Component: garment-analyzer.ts, decision-engine.ts
# Required:  YES — OpenAI client initializes at module load; server won't start
#            without a key
# Note:       Variable name in code is OPENAPI_API_KEY (not OPENAI_API_KEY).
# -----------------------------------------------------------------------------
OPENAPI_API_KEY=


# -----------------------------------------------------------------------------
# OpenRouter — Image generation (production render path)
# Component: OpenRouterProvider.ts, ai-pipeline.ts
# Required:  YES for creating renders — throws when a render is requested if unset
#            Server can start without it; /api/healthz and auth still work.
# Get key:   https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# Cloudflare R2 — Generated image storage (production render path)
# Component: rendering/image-storage.ts, lib/r2-config.ts
# Required:  YES for saving generated images to renders.outputImageUrl
# Get keys:  R2 → Overview → Manage API Tokens → Object Read & Write
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=


# -----------------------------------------------------------------------------
# FAL.ai — Remove Background refinement only (BirefNet)
# Component: services/image-processing/birefnet-background-removal-provider.ts
# Required:  YES for Remove Background — without FAL_KEY the refinement fails
#            clearly; normal OpenRouter generation does not use Fal.
# Get key:   https://fal.ai/dashboard/keys
# -----------------------------------------------------------------------------
FAL_KEY=


# -----------------------------------------------------------------------------
# OpenRouter tuning (optional overrides)
# Component: services/rendering/rendering.config.ts
# Required:  NO — sensible defaults exist
# -----------------------------------------------------------------------------
# OR_RENDER_MODEL=google/gemini-3.1-flash-image
# OR_RENDER_TIMEOUT_MS=90000
# OR_RENDER_RETRY_COUNT=1


# -----------------------------------------------------------------------------
# Dormant FASHN / FLUX Render Orchestrator (SL-017 — not in main render path)
# Component: rendering/render-orchestrator.ts, hybrid-strategy.ts
# Required:  NO — ai-pipeline uses OpenRouter, not getOrchestrator()
#            Only relevant if the orchestrator is re-wired into ai-pipeline.ts
# -----------------------------------------------------------------------------
# RENDER_MODE=AUTO
# HYBRID_RENDERING_ENABLED=false
# SCENE_CACHE_ENABLED=true


# -----------------------------------------------------------------------------
# Replit object storage (dormant — not wired to any route)
# Component: lib/objectStorage.ts
# Required:  NO — module exists but is not imported by the API
#            Only needed on Replit with Object Storage tool provisioned
# -----------------------------------------------------------------------------
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=


# -----------------------------------------------------------------------------
# Replit dev domain (optional local fallback exists)
# Component: preprocessing.ts — resolves relative identity image URLs
# Required:  NO — falls back to http://localhost:25562 when unset
# -----------------------------------------------------------------------------
# REPLIT_DEV_DOMAIN=


# -----------------------------------------------------------------------------
# Transactional email (welcome email on account creation)
# Component: artifacts/api-server/src/services/email/
# Required:  NO — without these vars, welcome emails are logged only (local dev)
# Provider:  Resend (https://resend.com) via HTTPS API — no extra npm dependency
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=StudioLayer AI <welcome@studiolayerai.com>


# =============================================================================
# Frontend (Vite) — usually set by npm scripts, not this file
# =============================================================================
# Component: artifacts/studiolayer-ai
# Defaults are baked into package.json dev script and vite.config.ts:
#   PORT=25562
#   BASE_PATH=/
# Vite proxies /api → http://localhost:8080 (see vite.config.ts)
#
# Production build (artifacts/studiolayer-ai/.env.production):
#   VITE_API_URL=https://api.studiolayerai.com
# Local development leaves VITE_API_URL unset so Vite proxies /api → localhost:8080.
# Leave unset in local dev — relative /api paths use the Vite proxy.
# =============================================================================
